<Project>
  <!-- 패키지 버전을 이 파일 한 곳에서 관리한다(중앙 패키지 관리). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- FactoryMES 공유 패키지: 아래 정확한 버전만 허용한다. 새 버전은 이 줄을 바꿔 명시적으로 올린다.
       Contracts 1.1.0: 알림 설정 DTO 추가(Backend·Web만 올림, 다른 서비스는 1.0.0 유지). -->

  <ItemGroup>
    <PackageVersion
      Include="FactoryMES.Contracts"
      Version="[1.1.0]"
    />
    <PackageVersion
      Include="FactoryMES.Foundation"
      Version="[1.0.0]"
    />
  </ItemGroup>

  <!-- nuget.org 패키지 -->
  <ItemGroup>
    <PackageVersion
      Include="Yarp.ReverseProxy"
      Version="2.3.0"
    />
    <PackageVersion
      Include="Microsoft.AspNetCore.Components.WebAssembly"
      Version="10.0.15"
    />
    <PackageVersion
      Include="Microsoft.AspNetCore.Components.WebAssembly.Server"
      Version="10.0.15"
    />
  </ItemGroup>
</Project>

