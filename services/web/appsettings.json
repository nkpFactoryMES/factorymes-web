{
  "ExecutionPolicy": {
    "CloudAiEnabled": false,
    "ExternalDeliveryEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "backend",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "one": {
            "Address": "http://mes-backend:8080/"
          }
        }
      }
    }
  }
}
