    private async Task<List<DeliveryMockStatus>> MockStatusesAsync(IEnumerable<DeliveryView> rows)
    {
        var result = new List<DeliveryMockStatus>();
        foreach (var chunk in rows.Select(x => x.DeliveryId).Chunk(100))
        {
            var ids = string.Join(",", chunk);
            result.AddRange(
                await Api.GetAsync<DeliveryMockStatus[]>(
