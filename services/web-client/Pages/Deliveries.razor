    // 로컬 통신 발송의 수신 결과. 같은 방식으로 100건씩 묶어 조회한다.
    private async Task<List<LocalDeliveryStatus>> LocalStatusesAsync(IEnumerable<DeliveryView> rows)
    {
        var result = new List<LocalDeliveryStatus>();
        foreach (var chunk in rows.Select(x => x.DeliveryId).Chunk(100))
