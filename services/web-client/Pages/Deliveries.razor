        var reason = RetryReason.Trim();

        return RunAsync(
            async () =>
            {
                if (ListFailed)
                {
                    throw new InvalidOperationException("최신 발송 이력을 먼저 다시 조회해 주세요.");
                }

                if (reason.Length is < 1 or > 1000)
