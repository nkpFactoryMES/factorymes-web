                    throw new InvalidOperationException("재시도 사유: 1~1000자로 입력해 주세요.");
                }

                await Api.SendAsync<DeliveryView>(
                    $"api/v1/deliveries/{Uri.EscapeDataString(target.DeliveryId)}/retry",
                    new ReasonCommand(target.Version, reason)
                );
                CloseRetry();
                await LoadDeliveriesAsync();
            },
            done: "재시도를 접수했습니다. 전달기가 처리하면 '목록 새로고침'으로 결과를 확인해 주세요.",
            reloadOnConflict: () => ReloadRetryTargetAsync(target.DeliveryId)
