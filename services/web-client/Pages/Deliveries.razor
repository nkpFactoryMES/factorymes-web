    // 수신 완료(Mock·로컬 ACCEPTED)인데 행에 마지막 오류나 다음 시도가 남아 있으면 옛 행이다.
    private static bool Stale(
        IEnumerable<DeliveryView> rows,
        IEnumerable<DeliveryMockStatus> mock,
        IEnumerable<LocalDeliveryStatus> local
