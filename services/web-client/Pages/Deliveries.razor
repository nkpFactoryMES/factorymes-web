    private async Task LoadDeliveriesAsync()
    {
        try
        {
            var page = await Api.GetAsync<PageResult<DeliveryView>>(DeliveryPath());
            var statuses = await MockStatusesAsync(page.Items);
            var locals = await LocalStatusesAsync(page.Items);

            // 행을 읽은 뒤 수신 결과를 읽는 사이에 수신 확인이 커밋되면, 수신 완료인데 행은 옛 값
            // (마지막 오류·다음 시도 남음)으로 보일 수 있다. 그런 행이 있으면 목록만 한 번 더 읽는다.
            if (Stale(page.Items, statuses, locals))
