    private async Task ReloadRetryTargetAsync(string deliveryId)
    {
        await LoadDeliveriesAsync();
        var latest = Rows.FirstOrDefault(x => x.DeliveryId == deliveryId);
        if (latest is null || latest.Status != "FAILED")
        {
            RetryTarget = null;
            return;
        }

        RetryTarget = latest;
    }

    // ---- Mock 수신 내용 ----
    private Task OpenReceiptAsync(string deliveryId) => RunAsync(
        async () =>
        {
            try
            {
                var mock = await Api.GetAsync<MockReceiptView>(
                    $"api/v1/deliveries/{Uri.EscapeDataString(deliveryId)}/mock-receipt"
                );
                Receipt = new ShownReceipt(
                    false,
                    mock.DeliveryId,
                    mock.ReceiptId,
                    mock.Provider,
                    mock.Channel,
                    mock.DestinationKey,
                    mock.Subject,
                    mock.Body,
                    mock.MessageHash,
                    mock.AcceptedAt
                );
            }
            catch (ApiFault error) when (error.Status == 404)
            {
                Receipt = null;
                throw new InvalidOperationException("아직 Mock 수신 기록이 없습니다.");
            }
        }
    );

    // 로컬 통신 수신 내용(Mailpit·채팅 수신기가 받은 제목·본문·해시).
    private Task OpenLocalReceiptAsync(string deliveryId) => RunAsync(
        async () =>
        {
            try
            {
                var local = await Api.GetAsync<LocalReceiptView>(
                    $"api/v1/deliveries/{Uri.EscapeDataString(deliveryId)}/local-receipt"
                );
                Receipt = new ShownReceipt(
                    true,
                    local.DeliveryId,
                    local.ReceiptId,
                    local.Provider,
                    local.Channel,
                    local.DestinationKey,
                    local.Subject,
                    local.Body,
                    local.MessageHash,
                    local.AcceptedAt
                );
            }
            catch (ApiFault error) when (error.Status == 404)
            {
                Receipt = null;
                throw new InvalidOperationException("아직 로컬 수신 기록이 없습니다.");
            }
        }
    );

    private void CloseReceipt()
    {
        Receipt = null;
    }

    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        CloseRetry();
        CloseReceipt();
        CloseOutboxRetry();
    }

    // ---- Outbox 재처리 ----
    private OutboxView? OutboxTarget;
    private OutboxRetryState? OutboxState;
    private bool OutboxStateFailed;
    private string OutboxReason = "";
    private string OutboxNote = "";

    // 결과를 확인하지 못한 재처리 요청. 같은 요청 ID·상태 해시·사유로만 다시 보낸다.
    private OutboxRetryRequest? PendingOutboxRetry;

    private bool CanSendOutboxRetry =>
        PendingOutboxRetry is not null
        || (OutboxState is { CanRetry: true } && !OutboxStateFailed);

    private static string BlockText(string? reason) => reason switch
    {
        "ALREADY_HANDED_OFF" => "이미 로컬 전달기로 인계된 이벤트입니다.",
        "UNSUPPORTED_CONSUMER" => "운영 재처리 대상이 아닌 이벤트 종류입니다(설정 전달 등).",
        "NOT_FAILED" => "최종 실패 상태가 아닙니다.",
        "AUTOMATIC_RETRY_PENDING" => "자동 재시도가 아직 남아 있습니다. 끝난 뒤 다시 확인해 주세요.",
        null => "",
        _ => reason
    };

    private Task OpenOutboxRetryAsync(OutboxView item)
    {
        // 다른 이벤트를 열면 이전 이벤트의 입력·대기 요청은 버린다.
        if (OutboxTarget?.OutboxId != item.OutboxId)
        {
            OutboxReason = "";
            PendingOutboxRetry = null;
        }

        OutboxTarget = item;
        OutboxNote = "";
        return ReloadOutboxStateAsync();
    }

    private void CloseOutboxRetry()
    {
        OutboxTarget = null;
        OutboxState = null;
        OutboxStateFailed = false;
        OutboxNote = "";
    }

    private Task ReloadOutboxStateAsync() => RunAsync(LoadOutboxStateAsync, done: "재처리 상태를 읽었습니다.");

    // 최신 상태와 상태 해시를 읽는다. 실패하면 재처리 전송을 막는다.
    private async Task LoadOutboxStateAsync()
    {
        var id = OutboxTarget!.OutboxId;
        try
        {
            var state = await Api.GetAsync<OutboxRetryState>(
                $"api/v1/outbox-events/{Uri.EscapeDataString(id)}/retry-state"
            );
            if (OutboxTarget?.OutboxId != id)
            {
                return;
            }

            OutboxState = state;
            OutboxStateFailed = false;
        }
        catch (Exception)
        {
            OutboxStateFailed = true;
            throw;
        }
    }

    private async Task SendOutboxRetryAsync()
    {
        var outcome = "";
        await RunAsync(
            async () =>
            {
                var id = OutboxTarget!.OutboxId;
                var request = PendingOutboxRetry;
                if (request is null)
                {
                    if (OutboxStateFailed || OutboxState is not { CanRetry: true } state)
                    {
                        throw new InvalidOperationException("재처리 가능한 최신 상태를 먼저 확인해 주세요.");
                    }

                    var reason = OutboxReason.Trim();
                    if (reason.Length is < 1 or > 1000)
                    {
                        throw new InvalidOperationException("재처리 사유: 1~1000자로 입력해 주세요.");
                    }

                    request = new OutboxRetryRequest(
                        Guid.NewGuid().ToString(),
                        state.StateHash,
                        reason
                    );
                }

                PendingOutboxRetry = request;
                try
                {
                    await Api.SendAsync<OutboxRetryState>(
                        $"api/v1/outbox-events/{Uri.EscapeDataString(id)}/retry",
                        request
                    );
                    PendingOutboxRetry = null;
                    OutboxReason = "";
                    outcome = "accepted";
                    CloseOutboxRetry();
                    await LoadOutboxAsync();
                }
                catch (ApiFault error) when (error.Status == 409)
                {
                    // 다른 처리로 상태가 바뀌었다. 사유는 지키고 최신 상태를 다시 보여 준다(새 요청 ID로 재검토).
                    PendingOutboxRetry = null;
                    outcome = "conflict";
                    OutboxNote = "다른 변경으로 상태가 바뀌었습니다(" + error.Message + "). "
                        + "최신 상태를 확인한 뒤 다시 요청해 주세요.";
                    try
                    {
                        await LoadOutboxStateAsync();
                    }
                    catch (Exception)
                    {
                        OutboxNote += " 최신 상태도 읽지 못했습니다. '재처리 상태 다시 조회'를 눌러 주세요.";
                    }
                }
                catch (ApiFault error) when (error.Status == 422)
                {
                    // 원본 내용·수신자 정합성 검사 실패. 원문은 화면에서 고칠 수 없다.
                    PendingOutboxRetry = null;
                    outcome = "invalid";
                    OutboxNote = "이벤트 원본 정합성 검사에서 거절됐습니다(" + error.Message + "). "
                        + "원문은 고칠 수 없으므로 재처리할 수 없습니다.";
                }
            },
            done: "재처리를 접수했습니다. 이벤트가 다시 인계 대기로 돌아갔습니다(발송 성공 보장 아님)."
        );

        if (outcome == "conflict")
        {
            Message = "충돌로 재처리하지 않았습니다. 최신 상태를 확인해 주세요.";
        }
        else if (outcome == "invalid")
        {
            Message = "정합성 검사에서 거절돼 재처리하지 않았습니다.";
        }
    }

    // ---- Outbox ----
    private Task ReloadOutboxAsync() => RunAsync(LoadOutboxAsync, done: "Outbox 기록을 다시 읽었습니다.");

    private string OutboxPath() =>
        "api/v1/outbox-events?limit=50" + (OutboxFilter == "" ? "" : "&status=" + OutboxFilter);

    private async Task LoadOutboxAsync()
    {
        var page = await Api.GetAsync<PageResult<OutboxView>>(OutboxPath());
        Outbox = page.Items.ToList();
        OutboxCursor = page.NextCursor;
    }

    private Task FilterOutboxAsync(ChangeEventArgs args) => RunAsync(
        async () =>
        {
            OutboxFilter = args.Value?.ToString() ?? "";
            await LoadOutboxAsync();
        }
    );

    private Task MoreOutboxAsync() => RunAsync(
        async () =>
        {
            var page = await Api.GetAsync<PageResult<OutboxView>>(
                OutboxPath() + "&cursor=" + Uri.EscapeDataString(OutboxCursor!)
            );
            Outbox.AddRange(page.Items);
            OutboxCursor = page.NextCursor;
        }
    );

    // 버튼 하나의 처리. 409는 입력을 지키고 최신 값을 다시 읽는다(실패해도 화면 예외로 번지지 않음).
    // 통신 오류·5xx는 자동으로 다시 보내지 않는다(서버에서 이미 처리됐을 수 있음).
    private async Task RunAsync(
        Func<Task> action,
        string done = "완료했습니다.",
        Func<Task>? reloadOnConflict = null,
        bool keepPendingOnConflict = true
    )
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        Message = "처리 중입니다.";
        try
        {
            await action();
            Message = done;
        }
        catch (ApiFault error) when (error.Status == 409)
        {
            Message = "다른 변경과 충돌했습니다(" + error.Message + "). 입력은 그대로 두었습니다. "
                + "최신 값을 확인한 뒤 다시 시도해 주세요.";
            if (!keepPendingOnConflict)
            {
                // 같은 요청 ID가 다른 본문으로 쓰였다는 뜻이라 같은 요청 재전송을 그만둔다.
                PendingRequest = null;
                PendingLocalRequest = null;
            }

            if (reloadOnConflict is not null)
            {
                try
                {
                    await reloadOnConflict();
                }
                catch (Exception)
                {
                    Message += " 최신 값도 읽지 못했습니다. '최신 발송 이력 다시 조회'를 눌러 주세요.";
                }
            }
        }
        catch (ApiFault error) when (error.Status >= 500)
        {
            Message = "서버 응답을 확인하지 못했습니다. 다시 보내기 전에 새로고침해 결과를 확인해 주세요.";
        }
        catch (HttpRequestException)
        {
            Message = "네트워크 오류로 결과를 확인하지 못했습니다. 새로고침해 결과를 확인해 주세요.";
        }
        catch (ApiFault error)
        {
            Message = error.Message + $" ({error.Status})";
            if (error.Status is >= 400 and < 500 and not 408 and not 429)
            {
                // 서버가 요청 자체를 거절했으므로 같은 요청을 다시 보낼 이유가 없다.
                PendingRequest = null;
                PendingLocalRequest = null;
            }
        }
        catch (Exception error)
        {
            Message = error.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string Kst(DateTime utc) => utc.AddHours(9).ToString("yyyy-MM-dd HH:mm:ss");
}


