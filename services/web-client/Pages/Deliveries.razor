    {
        var accepted = mock.Where(x => x.Outcome == "ACCEPTED").Select(x => x.DeliveryId)
            .Concat(local.Where(x => x.Outcome == "ACCEPTED").Select(x => x.DeliveryId))
            .ToHashSet();
        return rows.Any(x => accepted.Contains(x.DeliveryId)
            && (x.Attempts < 1 || x.LastError is not null || x.NextAttemptAt is not null));
    }

    private Task ReloadDeliveriesAsync() => RunAsync(
