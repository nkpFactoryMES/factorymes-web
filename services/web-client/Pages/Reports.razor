@page "/reports"
@using FactoryMES.Web.Client
@using FactoryMES.Web.Client.Components
@inject MesApi Api

@* 일일 생산 통계(관리자 전용).
   CLOSED 작업만 마감 시각의 KST 영업일 기준으로 설비·품목별로 집계한다(서버가 계산).
   "아직 집계하지 않음", "집계했지만 실적 0", "집계 대기·실패"를 0 실적과 섞지 않는다. *@
<PageTitle>생산 통계 · FactoryMES</PageTitle>
<main>
  <header>
    <div>
      <p>FACTORY MES / REPORTS</p>
      <h1>생산 통계</h1>
      <p>@(User is null ? "로그인 확인 중" : $"{User.Name} · {(Admin ? "관리자" : "작업자")}")</p>
    </div>
  </header>
  <p role="status">@Message</p>

  @if (User is not null && !Admin)
  {
    <p>생산 통계는 관리자만 사용할 수 있습니다.</p>
  }

  @if (Admin)
  {
    <fieldset disabled="@Busy">
      <section class="report-query">
        <h2>일일 생산 집계</h2>
        <p class="hint">
          마감(CLOSED)된 MANUAL·AUTO 작업의 순원장을 마감 시각의 한국 영업일 기준으로 집계합니다.
          미마감·취소 작업은 빠지고, 역분개·총량 하향 조정은 반영된 순수량입니다. 집계는 1분마다 오늘·어제를 다시 계산합니다.
        </p>
        <div class="query-bar">
          <label>
            영업일
            <input
              type="date"
              min="2000-01-01"
              max="@Today"
              value="@BusinessDate"
              @onchange="SetDate"
            />
          </label>
          <button
            type="button"
            @onclick="LoadAsync"
          >집계 조회</button>
          <button
            type="button"
            @onclick="OpenRebuild"
          >재집계 요청</button>
        </div>
      </section>

      <div
        class="tabs"
        role="tablist"
        aria-label="통계 화면"
      >
        <button
          type="button"
          role="tab"
          aria-selected="@(Tab == "results" ? "true" : "false")"
          @onclick="ShowResultsTab"
        >집계 결과</button>
        <button
          type="button"
          role="tab"
          aria-selected="@(Tab == "runs" ? "true" : "false")"
          @onclick="ShowRunsTab"
        >작업 이력</button>
      </div>

      @if (Tab == "results" && LoadedDate is not null)
      {
        <section class="report-status @StateClass">
          <h2>@LoadedDate 집계 상태</h2>
          <p class="state-line">
            <span class="badge @StateBadge">@StateLabel</span>
            @StateMessage
          </p>
          @if (Status?.LatestRun is { } run)
          {
            <dl class="run-facts">
              <dt>최근 작업</dt>
              <dd>#@run.JobRunId · @(run.Attempt)회차</dd>
              <dt>시작</dt>
              <dd>@Kst(run.StartedAt)</dd>
              <dt>종료</dt>
              <dd>@(run.EndedAt is null ? "-" : Kst(run.EndedAt.Value))</dd>
              <dt>처리 행</dt>
              <dd>@(run.AffectedRows?.ToString() ?? "-")</dd>
              @if (run.Error is not null)
              {
                <dt>오류</dt>
                <dd class="run-error">@ErrorText(run.Error)</dd>
              }
            </dl>
          }
          @if (Rows.Count > 0)
          {
            <p class="hint">
              아래 표의 마지막 갱신 시각은 @Kst(Rows.Max(x => x.RefreshedAt))입니다.
              최근 작업 상태와 시점이 다를 수 있습니다.
            </p>
          }
        </section>

        <section class="report-result">
          <h2>설비·품목별 실적</h2>
          @if (Rows.Count == 0)
          {
            <p class="empty-note">@EmptyMessage</p>
          }
          else
          {
            <ul class="legend">
              <li>
                <span class="swatch good"></span>
                양품
              </li>
              <li>
                <span class="swatch reject"></span>
                불량
              </li>
              <li>막대 길이는 이 화면에서 가장 큰 총량 대비 상대 크기입니다.</li>
            </ul>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>설비</th>
                    <th>품목</th>
                    <th class="num">총량</th>
                    <th class="num">불량</th>
                    <th class="num">양품</th>
                    <th class="num">불량률</th>
                    <th>비교</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var row in Rows)
                  {
                    var good = row.TotalQty - row.RejectQty;
                    <tr>
                      <td>@EquipmentLabel(row.EquipmentId)</td>
                      <td>@ProductLabel(row.ProductId)</td>
                      <td class="num">@row.TotalQty</td>
                      <td class="num">@row.RejectQty</td>
                      <td class="num">@good</td>
                      <td class="num">@RejectRate(row)</td>
                      <td>
                        <div
                          class="bar"
                          role="img"
                          aria-label="@($"총량 {row.TotalQty}, 양품 {good}, 불량 {row.RejectQty}")"
                        >
                          <span
                            class="bar-good"
                            style="width: @Percent(good)"
                          ></span>
                          <span
                            class="bar-reject"
                            style="width: @Percent(row.RejectQty)"
                          ></span>
                        </div>
                      </td>
                    </tr>
                  }
                </tbody>
                <tfoot>
                  <tr>
                    <th colspan="2">합계</th>
                    <td class="num">@Rows.Sum(x => x.TotalQty)</td>
                    <td class="num">@Rows.Sum(x => x.RejectQty)</td>
                    <td class="num">@Rows.Sum(x => x.TotalQty - x.RejectQty)</td>
                    <td class="num">@TotalRejectRate()</td>
                    <td></td>
                  </tr>
                </tfoot>
              </table>
            </div>
            @if (Cursor is not null)
            {
              <p class="hint">합계는 지금까지 불러온 행 기준입니다.</p>
              <button @onclick="MoreAsync">실적 더 보기</button>
            }
          }
        </section>
      }

      @if (Tab == "runs")
      {
        <section class="job-runs">
          <h2>최근 집계 작업</h2>
          <button @onclick="LoadRunsAsync">작업 이력 새로고침</button>
          @if (Runs.Count == 0)
          {
            <p>표시할 집계 작업이 없습니다.</p>
          }
          else
          {
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>작업</th>
                    <th>대상</th>
                    <th>상태</th>
                    <th>시작·종료</th>
                    <th class="num">처리 행</th>
                    <th>오류</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var run in Runs)
                  {
                    <tr>
                      <td>#@run.JobRunId · @(run.Attempt)회차</td>
                      <td>@run.JobKey</td>
                      <td>
                        <span class="badge @RunBadge(run.Status)">@RunLabel(run.Status)</span>
                      </td>
                      <td>
                        @Kst(run.StartedAt) ~
                        @(run.EndedAt is null ? "진행 중" : Kst(run.EndedAt.Value))
                      </td>
                      <td class="num">@(run.AffectedRows?.ToString() ?? "-")</td>
                      <td>@(run.Error is null ? "-" : ErrorText(run.Error))</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
          @if (RunCursor is not null)
          {
            <button @onclick="MoreRunsAsync">작업 이력 더 보기</button>
          }
        </section>
      }

      @* 재집계 요청 팝업: 사유 필수, 같은 요청 ID로만 재전송. 완료는 상태 조회로 확인한다. *@
      @if (RebuildOpen)
      {
        <div
          class="modal-backdrop"
          @onclick="CloseRebuild"
        ></div>
        <form
          class="modal rebuild-dialog"
          role="dialog"
          aria-modal="true"
          aria-label="@("재집계 요청 · " + RebuildDate)"
          @onsubmit="RebuildAsync"
          @onsubmit:preventDefault="true"
          @onkeydown="CloseOnEscape"
        >
          <div class="modal-bar">
            <button
              type="button"
              class="modal-close"
              @onclick="CloseRebuild"
            >닫기</button>
          </div>
          <p
            class="modal-status"
            role="status"
          >@Message</p>
          <h3>재집계 요청 · @RebuildDate</h3>
          <p class="hint">
            이 영업일의 집계를 원본 작업·원장에서 처음부터 다시 계산합니다(더하기가 아니라 다시 계산).
            요청은 먼저 대기 상태로 저장되고, 완료 여부는 집계 상태에서 확인합니다.
          </p>
          @if (PendingRun is not null)
          {
            <p class="conflict-wait">
              이전 요청의 결과를 확인하지 못했습니다. 같은 요청(같은 요청 ID·날짜·사유)으로만 다시 보냅니다.
            </p>
          }
          <label>
            재집계 사유
            <textarea
              @bind="RebuildReason"
              maxlength="1000"
              disabled="@(PendingRun is not null)"
            ></textarea>
          </label>
          <button type="submit">@(PendingRun is null ? "재집계 요청 보내기" : "같은 요청 다시 보내기")</button>
        </form>
      }
    </fieldset>
  }
</main>

@code {
    private SessionUser? User;
    private bool Admin => User?.Roles.Contains("ADMIN") == true;
    private string Message = "";
    private bool Busy;

    // 탭: 집계 결과(주 작업) / 집계 작업 이력.
    private string Tab = "results";

    private void ShowResultsTab()
    {
        Tab = "results";
    }

    private void ShowRunsTab()
    {
        Tab = "runs";
    }

    private string Today = "";
    private string BusinessDate = "";

    // 화면에 그린 결과의 날짜. 조회 도중 날짜를 바꾸면 늦게 온 결과는 버린다.
    private string? LoadedDate;
    private ReportingStatusView? Status;
    private List<DailyProductionView> Rows = [];
    private string? Cursor;

    private readonly Dictionary<string, string> EquipmentNames = [];
    private readonly Dictionary<string, string> ProductNames = [];

    private List<JobRunView> Runs = [];
    private string? RunCursor;

    private bool RebuildOpen;
    private string RebuildDate = "";
    private string RebuildReason = "";

    // 결과를 확인하지 못한 재집계 요청. 같은 UUID·날짜·사유로만 다시 보낸다.
    private ReportingRunRequest? PendingRun;

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(
            async () =>
            {
                User = await Api.GetAsync<SessionUser>("api/v1/auth/me");
                if (!Admin)
                {
                    return;
                }

                // 영업일은 서버 시각의 한국 날짜 기준이다(PC 시계와 무관).
                var serverUtc = await Api.GetServerTimeAsync();
                Today = serverUtc.AddHours(9).ToString("yyyy-MM-dd");
                BusinessDate = Today;

                await LoadNamesAsync();
                await LoadReportAsync(BusinessDate);
                await LoadRunPageAsync(null);
            }
        );
    }

    // ---- 집계 조회 ----
    private void SetDate(ChangeEventArgs args)
    {
        BusinessDate = args.Value?.ToString() ?? "";
    }

    private Task LoadAsync() => RunAsync(
        async () =>
        {
            CheckDate(BusinessDate);
            await LoadReportAsync(BusinessDate);
        }
    );

    private void CheckDate(string date)
    {
        var valid = DateOnly.TryParseExact(
            date,
            "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out _
        );
        if (!valid || string.CompareOrdinal(date, "2000-01-01") < 0
            || string.CompareOrdinal(date, Today) > 0)
        {
            throw new InvalidOperationException(
                "영업일은 2000-01-01부터 오늘(" + Today + ")까지 고를 수 있습니다."
            );
        }
    }

    // 상태와 첫 페이지를 모두 읽은 뒤에만 화면을 바꾼다.
    private async Task LoadReportAsync(string date)
    {
        var query = "businessDate=" + Uri.EscapeDataString(date);
        var status = await Api.GetAsync<ReportingStatusView>(
            "api/v1/reports/daily-production/status?" + query
        );
        var page = await Api.GetAsync<PageResult<DailyProductionView>>(
            "api/v1/reports/daily-production?" + query + "&limit=50"
        );

        if (date != BusinessDate)
        {
            return;
        }

        LoadedDate = date;
        Status = status;
        Rows = page.Items.ToList();
        Cursor = page.NextCursor;
    }

    private Task MoreAsync() => RunAsync(
        async () =>
        {
            var date = LoadedDate!;
            var page = await Api.GetAsync<PageResult<DailyProductionView>>(
                "api/v1/reports/daily-production?businessDate=" + Uri.EscapeDataString(date)
                    + "&limit=50&cursor=" + Uri.EscapeDataString(Cursor!)
            );
            if (date != LoadedDate)
            {
                return;
            }

            Rows.AddRange(page.Items);
            Cursor = page.NextCursor;
        }
    );

    // 설비·품목 이름표. 실패해도 ID로 보여 주면 되므로 통계 조회를 막지 않는다.
    private async Task LoadNamesAsync()
    {
        try
        {
            foreach (var item in await AllAsync<EquipmentChoice>("api/v1/equipment?limit=100"))
            {
                EquipmentNames[item.EquipmentId] = $"{item.Name} ({item.Code})";
            }

            foreach (var item in await AllAsync<ProductChoice>("api/v1/products?limit=100"))
            {
                ProductNames[item.ProductId] = $"{item.Name} ({item.Code})";
            }
        }
        catch (Exception)
        {
            // 이름 없이 ID만 표시한다.
        }
    }

    private async Task<List<T>> AllAsync<T>(string path)
    {
        var items = new List<T>();
        string? cursor = null;
        do
        {
            var suffix = cursor is null ? "" : "&cursor=" + Uri.EscapeDataString(cursor);
            var page = await Api.GetAsync<PageResult<T>>(path + suffix);
            items.AddRange(page.Items);
            cursor = page.NextCursor;
        }
        while (cursor is not null);

        return items;
    }

    private string EquipmentLabel(string id) =>
        EquipmentNames.TryGetValue(id, out var name) ? name : "설비 #" + id;

    private string ProductLabel(string id) =>
        ProductNames.TryGetValue(id, out var name) ? name : "품목 #" + id;

    // ---- 상태 문구: 미집계·집계 0·대기·실패를 구분한다 ----
    private string? RunStatus => Status?.LatestRun?.Status;

    private string StateClass => RunStatus switch
    {
        null => "state-none",
        "SUCCEEDED" => "state-ok",
        "FAILED" => "state-failed",
        _ => "state-running"
    };

    private string StateBadge => RunStatus switch
    {
        null => "closed",
        "SUCCEEDED" => "recovered",
        "FAILED" => "critical",
        _ => "warn"
    };

    private string StateLabel => RunStatus switch
    {
        null => "미집계",
        "SUCCEEDED" => "집계 완료",
        "FAILED" => "집계 실패",
        _ => "대기·진행 중"
    };

    private string StateMessage => RunStatus switch
    {
        null => "이 날짜는 아직 집계하지 않았습니다. 0 실적이 아닙니다.",
        "SUCCEEDED" => Rows.Count == 0
            ? "집계를 마쳤고 이 날짜에 마감된 실적이 없습니다(0)."
            : "집계를 마쳤습니다.",
        "FAILED" => Rows.Count == 0
            ? "집계가 실패해 결과가 없습니다. 오류를 확인한 뒤 재집계를 요청해 주세요."
            : "최근 집계가 실패했습니다. 아래 표는 그 전에 성공한 집계 결과입니다.",
        _ => "집계가 대기 중이거나 실행 중입니다. 잠시 뒤 '집계 조회'로 다시 확인해 주세요."
    };

    private string EmptyMessage => RunStatus switch
    {
        null => "아직 집계하지 않아 표시할 결과가 없습니다.",
        "SUCCEEDED" => "이 날짜에 마감된 작업 실적이 없습니다(0).",
        "FAILED" => "집계 실패로 결과가 없습니다.",
        _ => "집계가 끝나면 결과가 표시됩니다."
    };

    // 서버는 오류 코드 두 가지만 준다. 코드는 그대로 두고 뜻을 덧붙인다.
    private static string ErrorText(string code) => code switch
    {
        "REPORTING_AUTO_NOT_SUPPORTED" =>
            code + " · 이 날짜에 AUTO 방식 마감 작업이 있어 집계하지 않았습니다"
                + "(AUTO 실적 집계는 아직 지원하지 않음).",
        "REPORTING_REBUILD_FAILED" =>
            code + " · 재계산 중 오류가 났습니다. 이전 성공 결과는 그대로이며, "
                + "잠시 뒤 재집계를 다시 요청해 주세요.",
        "REPORTING_CLOCK_REGRESSION" =>
            code + " · 서버 시각이 거꾸로 간 것을 감지해 집계를 되돌렸습니다. "
                + "서버 시계를 확인한 뒤 재집계를 다시 요청해 주세요.",
        _ => code
    };

    private static string RunBadge(string status) => status switch
    {
        "SUCCEEDED" => "recovered",
        "FAILED" => "critical",
        _ => "warn"
    };

    private static string RunLabel(string status) => status switch
    {
        "SUCCEEDED" => "성공",
        "FAILED" => "실패",
        "RUNNING" => "대기·진행 중",
        _ => status
    };

    private static string RejectRate(DailyProductionView row) =>
        row.TotalQty == 0 ? "-" : (100.0 * row.RejectQty / row.TotalQty).ToString("0.0") + "%";

    private string TotalRejectRate()
    {
        var total = Rows.Sum(x => x.TotalQty);
        if (total == 0)
        {
            return "-";
        }

        return (100.0 * Rows.Sum(x => x.RejectQty) / total).ToString("0.0") + "%";
    }

    // 막대 길이: 화면에 있는 가장 큰 총량을 100%로 둔다.
    private string Percent(long value)
    {
        var max = Rows.Count == 0 ? 0 : Rows.Max(x => x.TotalQty);
        var ratio = max <= 0 ? 0 : Math.Clamp(100.0 * value / max, 0, 100);
        return ratio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    // ---- 작업 이력 ----
    private async Task LoadRunPageAsync(string? cursor)
    {
        var suffix = cursor is null ? "" : "&cursor=" + Uri.EscapeDataString(cursor);
        var page = await Api.GetAsync<PageResult<JobRunView>>("api/v1/job-runs?limit=20" + suffix);
        if (cursor is null)
        {
            Runs = page.Items.ToList();
        }
        else
        {
            Runs.AddRange(page.Items);
        }

        RunCursor = page.NextCursor;
    }

    private Task LoadRunsAsync() => RunAsync(() => LoadRunPageAsync(null));

    private Task MoreRunsAsync() => RunAsync(() => LoadRunPageAsync(RunCursor));

    // ---- 재집계 요청 ----
    private void OpenRebuild()
    {
        try
        {
            CheckDate(BusinessDate);
        }
        catch (InvalidOperationException error)
        {
            Message = error.Message;
            return;
        }

        RebuildOpen = true;
        if (PendingRun is null || PendingRun.BusinessDate != BusinessDate)
        {
            PendingRun = null;
            RebuildDate = BusinessDate;
            RebuildReason = "";
        }
    }

    private void CloseRebuild()
    {
        RebuildOpen = false;
    }

    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseRebuild();
        }
    }

    private Task RebuildAsync()
    {
        var request = PendingRun ?? new ReportingRunRequest(
            RebuildDate,
            Guid.NewGuid().ToString(),
            RebuildReason.Trim()
        );

        return RunAsync(
            async () =>
            {
                if (request.Reason.Length is < 1 or > 1000)
                {
                    throw new InvalidOperationException("재집계 사유: 1~1000자로 입력해 주세요.");
                }

                PendingRun = request;
                var run = await Api.SendAsync<JobRunView>(
                    "api/v1/reports/daily-production/rebuild",
                    request
                );
                PendingRun = null;
                RebuildOpen = false;
                RebuildReason = "";

                await LoadRunPageAsync(null);
                if (LoadedDate == request.BusinessDate)
                {
                    await LoadReportAsync(request.BusinessDate);
                }

                Message = $"재집계 요청 #{run.JobRunId}를 접수했습니다. "
                    + "완료는 '집계 조회'로 확인해 주세요.";
            },
            keepMessage: true
        );
    }

    // 버튼 하나의 처리. 5xx·통신 오류는 자동 재전송하지 않고, 같은 요청만 다시 보낼 수 있게 남긴다.
    // 409·422 등 서버가 요청을 거절하면 같은 요청 재전송을 그만둔다(입력은 유지).
    private async Task RunAsync(Func<Task> action, bool keepMessage = false)
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        Message = "처리 중입니다.";
        try
        {
            await action();
            if (!keepMessage)
            {
                Message = "완료했습니다.";
            }
        }
        catch (ApiFault error) when (error.Status >= 500)
        {
            Message = "서버 응답을 확인하지 못했습니다. 다시 보내기 전에 새로고침해 결과를 확인해 주세요.";
        }
        catch (HttpRequestException)
        {
            Message = "네트워크 오류로 결과를 확인하지 못했습니다. 새로고침해 결과를 확인해 주세요.";
        }
        catch (ApiFault error)
        {
            Message = error.Message + $" ({error.Status})";
            if (error.Status is not 408 and not 429)
            {
                PendingRun = null;
            }
        }
        catch (InvalidOperationException error)
        {
            Message = error.Message;
            PendingRun = null;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string Kst(DateTime utc) => utc.AddHours(9).ToString("yyyy-MM-dd HH:mm:ss");
}
