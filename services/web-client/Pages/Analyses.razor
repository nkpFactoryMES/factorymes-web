        "ANALYSIS_INPUT_LIMIT" =>
            "사전 집계 도입 전 원시 자료 10000개 상한에 걸린 예전 기록입니다. "
                + "지금 요청은 1분 사전 집계로 처리해 원시 행 상한이 없습니다.",
        "ANALYSIS_SCHEDULE_REJECTED" => "예약 분석 요청이 입력 검사에서 거절됐습니다.",
        "ANALYSIS_INPUT_CHANGED" => "분석 입력이나 설정이 요청 뒤 바뀌어 실행하지 않았습니다.",
        "ANALYSIS_RESULT_REJECTED" => "분석 결과가 입력·설정·점검 규칙과 맞지 않아 저장하지 않았습니다.",
        "ANALYSIS_TRANSPORT_FAILED" =>
            "분석기(Mock·로컬 AI)까지 전달하지 못했거나 제한 시간 안에 응답이 없었습니다(자동 재시도 없음).",
        "ANALYSIS_PROVIDER_REJECTED" =>
            "분석기가 요청을 거절했습니다(설정·입력·로컬 모델 상태 확인). Mock으로 대체하지 않습니다.",
        "ANALYSIS_INPUT_UNAVAILABLE" => "분석 입력을 읽지 못해 실행하지 않았습니다.",
        "ANALYSIS_DEADLINE_EXPIRED" => "처리 기한을 넘겼습니다(자동 재시도 없음).",
        _ => "알 수 없는 오류 코드입니다."
    };

    private static string StateHint(string state) => state switch
    {
        "QUEUED" => "처리 대기 중입니다.",
        "DISPATCHED" => "분석기로 보냈습니다. 결과를 기다리는 중입니다(로컬 AI는 최대 2분).",
        "TIMED_OUT" => "처리 기한을 넘겼습니다. 자동으로 다시 시도하지 않습니다.",
        "INSUFFICIENT_DATA" => "데이터가 부족해 분석하지 않았습니다(결과 없음).",
        "FAILED" => "처리에 실패했습니다. 오류를 확인해 주세요.",
        _ => ""
    };

    // 버튼 하나의 처리. 5xx·통신 오류는 자동 재전송하지 않고 같은 요청만 다시 보낼 수 있게 남긴다.
    // 서버가 요청을 거절(4xx)하면 같은 요청 재전송을 그만둔다(입력은 유지).
    private async Task RunAsync(Func<Task> action, string done = "완료했습니다.")
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        Message = "처리 중입니다.";
        try
        {
            await action();
            Message = done;
        }
        catch (ApiFault error) when (error.Status >= 500)
        {
            Message = "서버 응답을 확인하지 못했습니다. 다시 보내기 전에 새로고침해 결과를 확인해 주세요.";
        }
        catch (HttpRequestException)
        {
            Message = "네트워크 오류로 결과를 확인하지 못했습니다. 새로고침해 결과를 확인해 주세요.";
        }
        catch (ApiFault error)
        {
            Message = error.Message + $" ({error.Status})";
            if (error.Status is not 408 and not 429)
            {
                PendingRequest = null;
            }
        }
        catch (InvalidOperationException error)
        {
            Message = error.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    // 분석 이력 표의 결과 칸: 공급자(Mock·로컬 AI)와 건수.
    private static string ResultCount(AnalysisJobView job)
    {
        if (job.Results.Length == 0)
        {
            return "없음";
        }

        var kind = job.Results.All(x => x.MockFlag) ? "Mock" : "로컬 AI";
        return $"{kind} {job.Results.Length}건";
    }

    // 시연 규칙 위험도 표시 색. 경보가 아니라 참고 표시다.
    private static string RiskBadge(string risk) => risk switch
    {
        "HIGH" => "critical",
        "MEDIUM" => "warn",
        "LOW" => "recovered",
        _ => "closed"
    };

    private static string Kst(DateTime utc) => utc.AddHours(9).ToString("yyyy-MM-dd HH:mm:ss");
}
