@inherits LayoutComponentBase
@implements IDisposable
@inject MesApi Api
@inject NavigationManager Navigation

@* 모든 업무 화면의 공통 shell: 고정 상단, 역할별 그룹 사이드 메뉴, 본문만 스크롤, 푸터.
   업무 페이지 사이 이동에서는 이 레이아웃이 그대로 남고 @Body만 바뀐다.
   관리자 전용 메뉴는 화면에서만 숨기고, 권한은 서버가 최종 판단한다. *@
<div class="shell @(MenuOpen ? "menu-open" : null)">
  <header class="shell-top">
    <button
      type="button"
      class="menu-toggle"
      aria-controls="shell-menu"
      aria-expanded="@(MenuOpen ? "true" : "false")"
      @onclick="ToggleMenu"
    >메뉴</button>
    <NavLink
      class="brand"
      href="/dashboard"
    >FactoryMES</NavLink>
    <span class="shell-user">
      @(User is null ? "로그인 확인 중" : $"{User.Name} · {(Admin ? "관리자" : "작업자")}")
    </span>
    @if (Error is not null)
    {
      <span
        class="shell-error"
        role="alert"
      >@Error</span>
    }
    <button
      type="button"
      class="logout"
      disabled="@LoggingOut"
      @onclick="LogoutAsync"
    >로그아웃</button>
  </header>

  <div
    class="shell-backdrop"
    @onclick="CloseMenu"
  ></div>

  <nav
    id="shell-menu"
    class="shell-menu"
    aria-label="업무 메뉴"
    @onkeydown="CloseMenuOnEscape"
  >
    @if (User is not null)
    {
      @foreach (var group in Groups())
      {
        <p class="menu-group">@group.Title</p>
        <ul>
          @foreach (var item in group.Items)
          {
            <li>
              <NavLink
                href="@item.Href"
                Match="NavLinkMatch.Prefix"
              >@item.Label</NavLink>
            </li>
          }
        </ul>
      }
    }
  </nav>

  <div class="shell-body">
    @Body
  </div>

  @* 푸터는 본문 스크롤 밖 마지막 행이라 상단·메뉴와 함께 늘 보인다. *@
  <footer class="shell-footer">
    FactoryMES 로컬 개발 환경 · 이메일·채팅은 Mock 수신만, 유료 AI 호출 없음
  </footer>
</div>

@code {
    private SessionUser? User;
    private bool Admin => User?.Roles.Contains("ADMIN") == true;
    private bool MenuOpen;
    private bool LoggingOut;
    private string? Error;

    private sealed record MenuItem(string Href, string Label);

    private sealed record MenuGroup(string Title, MenuItem[] Items);

    protected override async Task OnInitializedAsync()
    {
        // 화면을 옮겨 다녀도 메뉴가 닫히도록 이동을 지켜본다.
        Navigation.LocationChanged += OnLocationChanged;
        try
        {
            User = await Api.GetAsync<SessionUser>("api/v1/auth/me");
        }
        catch (ApiFault error) when (error.Status == 401)
        {
            // 세션이 없으면 로그인 화면으로 돌아간다.
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception)
        {
            Error = "사용자 정보를 읽지 못했습니다. 새로고침해 주세요.";
        }
    }

    private IEnumerable<MenuGroup> Groups()
    {
        // 대시보드도 shell 안의 업무 화면이라 문서를 새로 열지 않는다.
        yield return new MenuGroup("현황", [new MenuItem("/dashboard", "대시보드")]);

        var production = new List<MenuItem> { new("/orders", "작업지시") };
        var equipment = new List<MenuItem> { new("/alarms", "경보") };
        var notices = new List<MenuItem> { new("/inbox", "알림함") };
        if (Admin)
        {
            production.Add(new MenuItem("/reports", "생산 통계"));
            equipment.Add(new MenuItem("/equipment-connections", "설비 연결"));
            equipment.Add(new MenuItem("/analyses", "설비 분석"));
            notices.Add(new MenuItem("/deliveries", "발송 이력"));
        }

        yield return new MenuGroup("생산", production.ToArray());
        yield return new MenuGroup("설비", equipment.ToArray());
        yield return new MenuGroup("알림", notices.ToArray());
        if (Admin)
        {
            yield return new MenuGroup("기준", [new MenuItem("/master-data", "기준정보")]);
        }
    }

    private void ToggleMenu()
    {
        MenuOpen = !MenuOpen;
    }

    private void CloseMenu()
    {
        MenuOpen = false;
    }

    private void CloseMenuOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            MenuOpen = false;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (MenuOpen)
        {
            MenuOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    // 로그아웃은 이 자리에서 바로 처리하고 로그인 화면으로 돌아간다.
    private async Task LogoutAsync()
    {
        LoggingOut = true;
        Error = null;
        try
        {
            await Api.LogoutAsync();
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception)
        {
            Error = "로그아웃하지 못했습니다. 다시 눌러 주세요.";
            LoggingOut = false;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
