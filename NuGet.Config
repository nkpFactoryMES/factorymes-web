<?xml version="1.0" encoding="utf-8"?>
<!-- 패키지 출처 두 곳.
     - factorymes-local: build/restore-packages.ps1이 공개 Release에서 받아 SHA-256을 확인한 .packages 폴더
     - nuget.org: 그 밖의 공개 패키지
     packageSourceMapping으로 FactoryMES.* 는 로컬 폴더에서만 받는다(같은 이름의 외부 패키지를 끌어오지 않게).
     globalPackagesFolder: 이 레포 전용 캐시(.nuget/packages, Git 제외)를 쓴다. 사용자 전역 캐시에
     같은 id·버전의 다른 내용이 남아 있으면 NuGet이 그것을 그대로 써서 잠금 파일이 틀어지기 때문이다. -->
<configuration>
  <config>
    <add
      key="globalPackagesFolder"
      value=".nuget/packages"
    />
  </config>
  <packageSources>
    <clear />
    <add
      key="factorymes-local"
      value=".packages"
    />
    <add
      key="nuget.org"
      value="https://api.nuget.org/v3/index.json"
    />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="factorymes-local">
      <package pattern="FactoryMES.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
